This worked for me:


assignInNamespace("model.matrix.lme", \(object, ...) {
     data <- if (is.null(object$data)) eval(object$call$data) else object$data
     model.matrix(formula(object), data = data, contrasts.arg = object$contrasts)
}, ns = "car")







