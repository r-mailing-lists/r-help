  cutoff = 0.01
)


str(coords)

# 3. Define SPDE model
spde <- inla.spde2.pcmatern(
  mesh = mesh,
  alpha = 2,
  prior.range = c(0.5, 0.01),   # P(range < 0.5) = 0.01
  prior.sigma = c(1, 0.01)      # P(sigma > 1) = 0.01
)

# 4. Create spatial index and projector matrix
